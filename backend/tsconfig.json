{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",

    "lib": ["ES2021"],

    "moduleResolution": "node",

    "declaration": true,
    "removeComments": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "sourceMap": true,

    "outDir": "./dist",

    "incremental": false,

    "skipLibCheck": true,
    "strict": false,

    "types": ["node"]
  },

  "include": ["src/**/*"],

  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts"
  ]
}